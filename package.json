{
  "name": "ledgerline-monorepo",
  "private": true,
  "scripts": {
    "build": "pnpm --filter ./apps/* build",
    "dev:api": "pnpm --filter api dev",
    "dev:web": "pnpm --filter web dev",
    "test": "pnpm --filter api test",
    "test:concurrency": "pnpm --filter api test:concurrency",
    "test:chaos": "pnpm --filter api test:chaos",
    "prisma:generate": "pnpm --filter api prisma:generate",
    "prisma:migrate": "pnpm --filter api prisma:migrate",
    "prisma:seed": "pnpm --filter api prisma:seed",
    "bootstrap:admin": "tsx apps/api/scripts/bootstrap-admin.ts",
    "db:bootstrap": "tsx apps/api/scripts/bootstrap-admin.ts",
    "db:generate": "pnpm --filter api prisma:generate",
    "db:migrate": "pnpm --filter api prisma:migrate",
    "db:seed": "pnpm --filter api prisma:seed"
  },
  "packageManager": "pnpm@9.1.0",
  "devDependencies": {
    "next": "14.2.3",
    "puppeteer-core": "^25.16.0",
    "typescript": "^5.4.5"
  }
}
