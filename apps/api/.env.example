# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/ledgerline?schema=public&connection_limit=50&pool_timeout=30"

# JWT configuration
JWT_SECRET="replace-with-a-secure-random-secret-for-access-tokens"
